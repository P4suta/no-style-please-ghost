{{!< default}}

{{#post}}
    <article class="reading {{post_class}}">
        <header class="article-heading measure">
            <div class="dateline">
                <time datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at}}</time>
                <span>{{reading_time minute=(t "1 min read") minutes=(t "% min read")}}</span>
            </div>
            <h1>{{title}}</h1>
            {{#if custom_excerpt}}<p>{{custom_excerpt}}</p>{{/if}}
            {{#if authors}}<div class="byline">{{{t "By {authors}" authors=(authors separator=", ")}}}</div>{{/if}}
        </header>
        {{#if feature_image}}{{> "components/feature-image" image=feature_image alt=feature_image_alt caption=feature_image_caption}}{{/if}}
        {{> reading-content}}
        {{#if tags}}<footer class="tags measure">{{#foreach tags}}<a class="action" href="{{url}}"><span aria-hidden="true">#</span><span>{{name}}</span></a>{{/foreach}}</footer>{{/if}}
    </article>
    <div class="measure afterword">
        {{> "components/prev-next"}}
        {{> "components/related"}}
        {{comments}}
    </div>
{{/post}}
