{{!< default}}

<header class="masthead frame">
    {{#if @site.logo}}
        <img class="masthead-logo" src="{{img_url @site.logo size="s"}}"
             srcset="{{img_url @site.logo size="s"}} 320w, {{img_url @site.logo size="m"}} 600w"
             sizes="(max-width: 20rem) 90vw, 18rem" width="288" height="64" alt="">
    {{/if}}
    <h1>{{@site.title}}</h1>
    {{#if @site.description}}<p>{{@site.description}}</p>{{/if}}
</header>
<div class="frame archive">
    {{#if @custom.show_featured_posts}}
        {{#get "posts" filter="featured:true+visibility:public" limit="3" as |selection|}}
            {{#if selection}}
                <section class="featured" aria-labelledby="featured-heading">
                    <h2 id="featured-heading">{{t "Featured"}}</h2>
                    {{> post-list items=selection}}
                </section>
            {{/if}}
        {{/get}}
    {{/if}}
    <section aria-labelledby="latest-heading">
        <h2 id="latest-heading">{{t "Latest posts"}}</h2>
        {{> post-list items=posts}}
    </section>
    {{pagination}}
</div>
