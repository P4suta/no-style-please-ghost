<!doctype html>
<html lang="{{@site.locale}}"{{#match @site.locale "ar"}} dir="rtl"{{else match @site.locale "~^" "ar-"}} dir="rtl"{{/match}}>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{meta_title page=(t " (Page %)")}}</title>
    {{#unless @site.icon}}<link rel="icon" href="{{@site.url}}/favicon.ico">{{/unless}}
    <link rel="stylesheet" href="{{asset "css/style.css"}}">
    {{ghost_head}}
</head>
<body class="{{body_class}}" data-body-font="{{@custom.body_font}}" data-heading-font="{{@custom.heading_font}}">
    <a class="skip-link action" href="#content" tabindex="0"><span aria-hidden="true">↓</span>{{t "Skip to content"}}</a>
    <header class="site-bar frame">
        {{#is "home"}}{{else}}
            <a class="publication action" href="{{@site.url}}/"><span aria-hidden="true">←</span><span>{{@site.title}}</span></a>
        {{/is}}
        {{#if @site.navigation}}
            <nav aria-label="{{t "Menu"}}">{{navigation}}</nav>
        {{/if}}
        <a class="search action" href="#/search" data-ghost-search><span class="magnifier" aria-hidden="true"></span><span>{{t "Search"}}</span></a>
    </header>
    <main id="content" tabindex="-1">
        {{{body}}}
    </main>
    {{> "components/footer"}}
    {{ghost_foot}}
</body>
</html>
