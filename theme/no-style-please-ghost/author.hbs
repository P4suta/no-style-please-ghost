{{!< default}}

<div class="frame archive">
    {{#author}}
        <header class="archive-heading">
            {{#if profile_image}}<img class="portrait" src="{{img_url profile_image size="xs"}}" alt="" width="80" height="80">{{/if}}
            <h1>{{name}}</h1>
            {{#if bio}}<p>{{bio}}</p>{{/if}}
            {{#if location}}<p>{{location}}</p>{{/if}}
            <div class="author-links">
                {{#if website}}<a class="action" href="{{website}}" rel="me"><span aria-hidden="true">↗</span><span>{{website}}</span></a>{{/if}}
                {{#if twitter}}<a class="action" href="{{social_url type="twitter"}}" rel="me"><span aria-hidden="true">↗</span><span>X</span></a>{{/if}}
                {{#if facebook}}<a class="action" href="{{social_url type="facebook"}}" rel="me"><span aria-hidden="true">↗</span><span>Facebook</span></a>{{/if}}
                {{#if linkedin}}<a class="action" href="{{social_url type="linkedin"}}" rel="me"><span aria-hidden="true">↗</span><span>LinkedIn</span></a>{{/if}}
                {{#if bluesky}}<a class="action" href="{{social_url type="bluesky"}}" rel="me"><span aria-hidden="true">↗</span><span>Bluesky</span></a>{{/if}}
                {{#if threads}}<a class="action" href="{{social_url type="threads"}}" rel="me"><span aria-hidden="true">↗</span><span>Threads</span></a>{{/if}}
                {{#if mastodon}}<a class="action" href="{{social_url type="mastodon"}}" rel="me"><span aria-hidden="true">↗</span><span>Mastodon</span></a>{{/if}}
                {{#if tiktok}}<a class="action" href="{{social_url type="tiktok"}}" rel="me"><span aria-hidden="true">↗</span><span>TikTok</span></a>{{/if}}
                {{#if youtube}}<a class="action" href="{{social_url type="youtube"}}" rel="me"><span aria-hidden="true">↗</span><span>YouTube</span></a>{{/if}}
                {{#if instagram}}<a class="action" href="{{social_url type="instagram"}}" rel="me"><span aria-hidden="true">↗</span><span>Instagram</span></a>{{/if}}
            </div>
        </header>
    {{/author}}
    {{> post-list items=posts}}
    {{pagination}}
</div>
