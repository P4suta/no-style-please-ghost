{{!< default}}

<div class="frame archive">
    {{#tag}}
        <header class="archive-heading">
            <h1>{{name}}</h1>
            {{#if description}}<p>{{description}}</p>{{/if}}
            {{#if feature_image}}{{> "components/feature-image" image=feature_image}}{{/if}}
        </header>
    {{/tag}}
    {{> post-list items=posts}}
    {{pagination}}
</div>
