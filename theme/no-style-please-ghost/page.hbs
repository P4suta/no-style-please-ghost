{{!< default}}

{{#post}}
  {{> back-link}}

  <article class="{{post_class}}">
    {{#match @page.show_title_and_feature_image}}
      <h1>{{title}}</h1>

      {{#if feature_image}}
        {{> "components/feature-image"
          image=feature_image
          alt=feature_image_alt
          fallback_alt=title
          caption=feature_image_caption}}
      {{/if}}
    {{/match}}

    {{content}}
  </article>
{{/post}}
