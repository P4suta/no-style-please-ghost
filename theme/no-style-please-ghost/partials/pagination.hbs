{{!-- Overrides the default template for Ghost's built-in pagination
  helper. Ghost looks for partials/pagination.hbs first and falls back
  to the stock template only when absent
  (docs.ghost.org/themes/helpers/pagination). Labels are routed through
  the t helper so locales/*.json dictionaries pick up Newer posts /
  Older posts. --}}
<nav class="pagination">
  {{#if prev}}
    <a class="newer-posts" href="{{page_url prev}}" rel="prev">&larr; {{t "Newer posts"}}</a>
  {{/if}}
  {{#if next}}
    <a class="older-posts" href="{{page_url next}}" rel="next">{{t "Older posts"}} &rarr;</a>
  {{/if}}
</nav>
