{{#match pages ">" 1}}
    <nav class="pagination" aria-label="{{t "Pagination"}}">
        {{#if prev}}<a class="action" href="{{page_url prev}}" rel="prev"><span aria-hidden="true">←</span><span>{{t "Newer posts"}}</span></a>{{/if}}
        <span class="page-number">{{page}} / {{pages}}</span>
        {{#if next}}<a class="action" href="{{page_url next}}" rel="next"><span>{{t "Older posts"}}</span><span aria-hidden="true">→</span></a>{{/if}}
    </nav>
{{/match}}
