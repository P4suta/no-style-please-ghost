{{#if posts}}
  <ul>
    {{#foreach posts}}
      <li>
        <span>
          <time datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at format="YYYY-MM-DD"}}</time>
        </span>
        <a href="{{url}}">{{title}}</a>
        {{!-- Flag gated posts with a plain text sigil so the list stays
          uniform — matches Source's "[Members only]" pattern without
          adding a lock icon. `{{^has visibility="public"}}` is truthy
          for any non-public visibility (members, paid, or tier-gated). --}}
        {{^has visibility="public"}}
          <span class="members-only">[{{t "Members only"}}]</span>
        {{/has}}
      </li>
    {{/foreach}}
  </ul>
{{/if}}
