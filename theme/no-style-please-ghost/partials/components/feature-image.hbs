<figure class="cover">
    <img src="{{img_url image size="l"}}" alt="{{alt}}"
         srcset="{{img_url image size="s"}} 320w, {{img_url image size="m"}} 600w, {{img_url image size="l"}} 960w, {{img_url image size="xl"}} 1200w, {{img_url image size="xxl"}} 2000w"
         sizes="(min-width: 62rem) 58rem, 94vw">
    {{#if caption}}<figcaption>{{{caption}}}</figcaption>{{/if}}
</figure>
