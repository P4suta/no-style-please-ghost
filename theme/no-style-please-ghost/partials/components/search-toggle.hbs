{{!-- Triggers Ghost's built-in Portal search overlay. `data-ghost-search`
  is the documented attribute Ghost attaches its listener to; no JS is
  required from the theme. Label is plain text (no icon) to keep with the
  "no-style" aesthetic. --}}
<button type="button" data-ghost-search aria-label="{{t "Search"}}">
  {{t "Search"}}
</button>
