<footer class="site-footer frame">
    {{#if @site.secondary_navigation}}
        <nav aria-label="{{t "Footer navigation"}}">{{navigation type="secondary"}}</nav>
    {{/if}}
    <div class="footer-links">
        <a class="action" href="{{@site.url}}/rss/"><span aria-hidden="true">↗</span><span>RSS</span></a>
        {{#if @site.members_enabled}}
            {{#if @member}}
                <a class="action" href="#/portal/account"><span aria-hidden="true">→</span><span>{{t "Account"}}</span></a>
            {{else}}
                <a class="action" href="#/portal/signin"><span aria-hidden="true">→</span><span>{{t "Sign in"}}</span></a>
                {{#if @site.allow_self_signup}}
                    <a class="action" href="#/portal/signup"><span aria-hidden="true">＋</span><span>{{t "Subscribe"}}</span></a>
                {{/if}}
            {{/if}}
        {{/if}}
    </div>
</footer>
