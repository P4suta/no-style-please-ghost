{{#prev_post}}
    <a class="adjacent action" href="{{url}}" rel="prev"><span aria-hidden="true">←</span><span><small>{{t "Previous post"}}</small>{{title}}</span></a>
{{/prev_post}}
{{#next_post}}
    <a class="adjacent action" href="{{url}}" rel="next"><span aria-hidden="true">→</span><span><small>{{t "Next post"}}</small>{{title}}</span></a>
{{/next_post}}
