{{#if primary_tag}}
    {{#get "posts" filter="primary_tag:{{primary_tag.slug}}+id:-{{id}}" include="tiers" limit="3" as |related|}}
        {{#if related}}
            <section class="related" aria-labelledby="related-heading">
                <h2 id="related-heading">{{t "Read next"}}</h2>
                {{> post-list items=related}}
            </section>
        {{/if}}
    {{/get}}
{{/if}}
