<ul class="nav-links" role="list">
    {{#foreach navigation}}
        <li><a class="action" href="{{url absolute="true"}}"{{#match (link_class for=(url)) "nav-current"}} aria-current="page"{{/match}}>
            {{#if icon}}<img class="nav-icon" src="{{icon}}" alt="{{iconAlt}}">{{else}}<span aria-hidden="true">↗</span>{{/if}}
            <span>{{label}}</span>
        </a></li>
    {{/foreach}}
</ul>
