{
  "name": "no-style-please-ghost-dev",
  "private": true,
  "packageManager": "bun@1.4.5",
  "description": "Development and verification tools for the Ghost reading theme.",
  "license": "MIT",
  "scripts": {
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "build:css": "lightningcss --bundle --minify --targets '>= 0.5%' theme/no-style-please-ghost/src/css/style.css -o theme/no-style-please-ghost/assets/css/style.css",
    "watch:css": "lightningcss --bundle --targets '>= 0.5%' --watch theme/no-style-please-ghost/src/css/style.css -o theme/no-style-please-ghost/assets/css/style.css",
    "zip": "bun run build:css && bun scripts/package-theme.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test tests/*.test.ts",
    "test:readers": "bun run zip && playwright test",
    "test": "bun run test:unit && bun run test:readers",
    "gscan": "node node_modules/gscan/bin/cli.js theme/no-style-please-ghost",
    "verify": "bun run check && bun run typecheck && bun run test && bun run gscan"
  },
  "overrides": {
    "readdir-glob": "4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@tryghost/portal": "2.72.38",
    "@tryghost/sodo-search": "1.9.7",
    "@types/node": "24.19.2",
    "fflate": "0.8.3",
    "gscan": "6.7.0",
    "handlebars": "4.7.10",
    "lightningcss-cli": "1.33.0",
    "typescript": "6.0.3"
  }
}
