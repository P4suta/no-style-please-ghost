# -----------------------------------------------------------------------------
# Ghost dev environment settings.
# Copy to `.env` and adjust before running `docker compose up`.
# These values are *development defaults* only — change before any public use.
# -----------------------------------------------------------------------------

# Host port mapping. Change if 2368 is already taken.
GHOST_HOST_PORT=2368

# Public URL for this Ghost instance (used for links in emails/admin).
GHOST_URL=http://localhost:2368

# Ghost runtime mode. `development` is less cached and friendlier for theme
# development; switch to `production` to simulate the deployed behaviour.
NODE_ENV=development

# MySQL credentials (dev defaults — not for production).
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=ghost
MYSQL_USER=ghost
MYSQL_PASSWORD=change-me
